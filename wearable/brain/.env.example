# Jarvis Brain settings.
# Copy this file to ".env" (setup.bat does that for you).
# Lines starting with # are notes. Do not put quotes around the values.

# Where the brain listens. 0.0.0.0 means "this laptop, including other
# devices on your Wi-Fi" so the watch can connect. Leave the port as 8787
# unless you already use that port for something else.
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8787

# Which brain to use.
#   openai  — any service that speaks the OpenAI chat API (default)
#   mock    — a built-in practice brain, no internet and no key
#   hermes  — a Hermes-style agent. See brain/jarvis_brain/llm/hermes.py
#   local   — same wire format as openai, meant for a model on this PC
# If openai or local is selected and LLM_API_KEY is empty, Jarvis
# quietly uses the practice brain so you can still test the watch.
LLM_PROVIDER=openai

# OpenAI-compatible endpoint. Change this to swap providers without
# touching code. Examples:
#   https://api.openai.com/v1
#   https://api.groq.com/openai/v1
#   http://127.0.0.1:11434/v1          (Ollama, on this laptop)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=120
LLM_TEMPERATURE=0.7

# How many past messages to remember for one watch session.
JARVIS_MEMORY_MESSAGES=8

# Optional: replace the built-in personality with your own text file.
# JARVIS_PERSONA_FILE=C:\Users\Kyla\jarvis-persona.txt

# Speech-to-text. "openai" uses the same kind of API as the chat model
# (the Whisper transcription endpoint). "mock" returns a practice sentence.
# If STT_API_KEY is empty, STT_API_KEY falls back to LLM_API_KEY.
# If that is empty too, speech uses the practice sentence.
STT_PROVIDER=openai
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# Only used when LLM_PROVIDER=hermes. The URL should be the base of an
# OpenAI-compatible server (ending in /v1) unless you edit hermes.py.
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes

# Later phases. These switches are read and reported, and they do not
# change behavior yet. See the roadmap in the main README.
TTS_PROVIDER=none
TAILSCALE_ENABLED=false
